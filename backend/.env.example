# ===========================================
# Workforce Pulse: Opportunity Navigator
# Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env to version control.
# ===========================================

# --- Bright Data API ---
BRIGHT_DATA_API_KEY=your_bright_data_api_key_here
BRIGHT_DATA_DATASET_ID=your_dataset_id_here

# --- Google Gemini API ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Application Settings ---
# Identifier for the deployment space
ENVIRONMENT=development

# Comma-separated list of origins allowed to make CORS requests to the backend
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000

# Backend host/port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
